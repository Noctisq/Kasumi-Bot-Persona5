{
    "compilerOptions": {
      "module": "commonjs",
      "esModuleInterop": true,
      "target": "ES2020",
      "moduleResolution": "node",
      "baseUrl": ".",
      "paths": {
        "googlevideo/sabr-stream": ["node_modules/googlevideo/dist/src/exports/sabr-stream.d.ts"],
        "googlevideo/utils": ["node_modules/googlevideo/dist/src/exports/utils.d.ts"]
      },
      "sourceMap": true,
      "outDir": "dist",
      "skipLibCheck": true
    },
    "lib": ["es2015"],
    "include": ["src/**/*.ts"]
  }